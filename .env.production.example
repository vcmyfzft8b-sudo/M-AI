NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://memoai.eu
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
GEMINI_OCR_RESCUE_MODEL=gemini-3-flash-preview
# Per-stage overrides (all optional; measured defaults live in src/lib/ai/model-config.ts).
# The one stage with its own default is note writing: gemini-3.5-flash-lite.
# GEMINI_NOTE_WRITE_MODEL=
# GEMINI_NOTE_EXTRACT_MODEL=
# GEMINI_NOTE_OUTLINE_MODEL=
# GEMINI_STUDY_ITEMS_MODEL=
# GEMINI_CHAT_MODEL=
# Rollback switches for the 2026-08 pipeline rework; unset means the new pipelines.
# NOTES_PIPELINE=legacy
# STUDY_PIPELINE=legacy
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v4
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE=Grace
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INTERNAL_JOB_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: set this only if Stripe should post to a final non-redirecting host
# that differs from NEXT_PUBLIC_SITE_URL (for example, if the public site URL redirects).
STRIPE_WEBHOOK_URL=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PREVIEW_AUTH_BYPASS=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://de.sentry.io
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Admin dashboard
# Apify token for collecting TikTok creator stats. Without it the dashboard
# still works, but posts have to be classified from data entered by hand.
# Apify bills per post scraped: see docs/admin-dashboard.md before changing the
# cron frequency or the value below.
APIFY_TOKEN=
# Posts pulled per creator per run (default 20). This is the main cost lever.
UGC_SYNC_POSTS_PER_PROFILE=
# Required for the scheduled collection in vercel.json. The endpoint refuses to
# run when no secret is configured, because a run spends money.
CRON_SECRET=

# Visitor analytics. Vercel Web Analytics supplies the traffic history and the
# live "online now" count; the on-site beacon names signed-in visitors.
# PROJECT_ID and TEAM_ID are injected automatically on Vercel.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=

# Apple in-app subscriptions. Enable only after staging lifecycle/deletion QA.
# Secrets are server-only. The Team ID is configured in Xcode, not here.
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=eu.memoai.memo
# Numeric Apple ID from App Store Connect > App Information:
APPLE_APP_ID=6812409212
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Full .p8 contents, with real newlines or literal \n separators:
APPLE_IAP_PRIVATE_KEY=
# Optional comma-separated synthetic account UUIDs for release TestFlight/App Review.
# Production accepts sandbox transactions ONLY for these explicitly named accounts.
APPLE_SANDBOX_REVIEW_USER_IDS=

# Native Sign in with Apple. Separate Apple Developer signing key; not the IAP key.
# Enable only after provider/audience configuration and revocation tests.
APPLE_SIGN_IN_ENABLED=false
# Native sign-in does not configure browser OAuth. Enable only after Services ID setup.
APPLE_WEB_SIGN_IN_ENABLED=false
APPLE_SIGN_IN_TEAM_ID=J4PCHZ8P7T
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
# 32 random bytes encoded as 64 hex characters; never rotate without re-encrypting grants.
APPLE_AUTH_TOKEN_ENCRYPTION_KEY=
