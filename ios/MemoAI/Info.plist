<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Memo AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.memoai.memo.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>eu.memoai.memo.auth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  App-bound domains. WKWebView runs a service worker only for a domain
	  listed here, with `limitsNavigationsToAppBoundDomains` set on the
	  configuration — without both, `navigator.serviceWorker.register` is
	  never even attempted and the app has no offline mode at all. Measured:
	  with this absent the web view requested `/sw.js` zero times.

	  `localhost` is for development, where the app is pointed at a local
	  build over TLS (see AppConfiguration). Production never navigates there.
	-->
	<key>WKAppBoundDomains</key>
	<array>
		<string>memoai.eu</string>
		<string>www.memoai.eu</string>
		<string>localhost</string>
		<string>$(MEMO_APP_BOUND_HOST)</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan study materials and attach photos to your notes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record lectures and speak with your Memo voice tutor.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save mindmap images exported from your notes to your photo library.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- Keep the portrait scene in iPad compatibility mode. iPadOS windowed
	     mode can still scale its presentation and show system resize controls. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
