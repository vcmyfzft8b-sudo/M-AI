{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "src/app/api/inngest/route.ts": { "regions": ["iad1"] },
    "src/app/api/internal/lectures/*/route.ts": { "regions": ["iad1"] },
    "src/app/api/lectures/[id]/retry/route.ts": { "regions": ["iad1"] }
  },
  "crons": [
    {
      "path": "/api/cron/account-erasure",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/ugc-sync?force=1",
      "schedule": "50 21 * * *"
    },
    {
      "path": "/api/cron/ai-cost-report",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/stalled-lectures",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/push-queue",
      "schedule": "* * * * *"
    }
  ]
}
